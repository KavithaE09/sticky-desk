{
  "manifest_version": 3,
  "name": "StickyDesk",
  "version": "1.0.0",
  "description": "Pin notes to any webpage. Auto-syncs with StickyDesk.",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": ["http://localhost:3000/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StickyDesk"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
